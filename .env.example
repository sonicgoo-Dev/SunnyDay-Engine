# Names only. Real values live in Render's settings and Eric's password manager.
# Never commit a filled-in copy of this file.

# The database (Render provides this for the hosted app).
DATABASE_URL=postgres://user:password@localhost:5432/sunnyday_dev

# The address the app answers at, with no slash at the end.
APP_URL=http://localhost:3300

# A long random string; signs sign-in cookies. One per machine.
SIGNIN_SECRET=

# The "SunnyDay sign-in" Google web client (Google Cloud project: SunnyDay).
SIGNIN_GOOGLE_CLIENT_ID=
SIGNIN_GOOGLE_CLIENT_SECRET=

# Who may sign in before the invite screen exists. Comma-separated emails.
FIRST_INVITES=

# Error reports. Leave empty to switch them off.
SENTRY_DSN=
